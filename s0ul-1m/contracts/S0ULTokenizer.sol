pragma solidity 0.8.30;

import {IS0ULTokenizer} from "./S0ULTypes.sol";

/// @notice Exact byte/domain-v1 longest-prefix tokenizer; ordinary text cannot create control IDs.
/// @dev Dictionary and domain SHA are generated from s0ul/tokenizer.py's frozen specification.
///      Decoding returns raw bytes. Invalid UTF-8 fallback bytes are preserved, not replaced.
contract S0ULTokenizer is IS0ULTokenizer {
    uint256 public constant MAX_INPUT_BYTES = 4096;
    uint256 public constant MAX_DECODE_IDS = 4096;
    uint256 public constant DOMAIN_COUNT = 161;
    uint256 private constant MAX_PIECE_BYTES = 14;
    bytes private constant PIECES = hex"";
    bytes private constant OFFSETS = hex"";
    bytes private constant BUCKETS = hex"";
    bytes private constant CANDIDATES = hex"";

    error InputTooLong();
    error InvalidToken();

    function domainSha256() external pure override returns (bytes32) {
        return 0x7de4830b9e32e5884d2ee9776fdae6c8c1b42a9278342ae22d7105b039e9a726;
    }

    function _u16(bytes memory data, uint256 at) private pure returns (uint256) {
        return (uint256(uint8(data[at])) << 8) | uint256(uint8(data[at + 1]));
    }

    function encode(string calldata text) external pure override returns (uint16[] memory ids) {
        bytes calldata raw = bytes(text);
        if (raw.length > MAX_INPUT_BYTES) revert InputTooLong();
        ids = new uint16[](raw.length);
        bytes memory dictionary = PIECES;
        bytes memory offsets = OFFSETS;
        bytes memory buckets = BUCKETS;
        bytes memory candidates = CANDIDATES;
        uint256 cursor;
        uint256 count;
        while (cursor < raw.length) {
            uint256 bucket = uint256(uint8(raw[cursor])) * 4;
            uint256 start = _u16(buckets, bucket);
            uint256 end = start + _u16(buckets, bucket + 2);
            uint256 matched;
            uint16 token;
            // Candidates are sorted by descending byte length, then ascending token ID.
            for (uint256 i = start; i < end; ++i) {
                uint256 index = uint8(candidates[i]);
                uint256 offset = _u16(offsets, index * 2);
                uint256 length = _u16(offsets, (index + 1) * 2) - offset;
                if (length > raw.length - cursor) continue;
                bool equal = true;
                for (uint256 j; j < length; ++j) {
                    if (raw[cursor + j] != dictionary[offset + j]) {
                        equal = false;
                        break;
                    }
                }
                if (equal) {
                    matched = length;
                    token = uint16(260 + index);
                    break;
                }
            }
            if (matched == 0) {
                token = uint16(4 + uint16(uint8(raw[cursor])));
                matched = 1;
            }
            ids[count++] = token;
            cursor += matched;
        }
        assembly ("memory-safe") { mstore(ids, count) }
    }

    function _reserved(uint256 id) private pure returns (bytes memory marker) {
        // Reserved IDs are in 421..511, so exactly three decimal digits suffice.
        marker = bytes("<UNUSED_000>");
        marker[8] = bytes1(uint8(48 + id / 100));
        marker[9] = bytes1(uint8(48 + (id / 10) % 10));
        marker[10] = bytes1(uint8(48 + id % 10));
    }

    function decode(uint16[] calldata ids, bool skipSpecial)
        external pure override returns (bytes memory result)
    {
        if (ids.length > MAX_DECODE_IDS) revert InputTooLong();
        result = new bytes(ids.length * MAX_PIECE_BYTES);
        bytes memory dictionary = PIECES;
        bytes memory offsets = OFFSETS;
        uint256 written;
        for (uint256 i; i < ids.length; ++i) {
            uint256 token = ids[i];
            if (token >= 512) revert InvalidToken();
            if (token < 4) {
                if (skipSpecial) continue;
                bytes memory control = token == 0 ? bytes("<PAD>") : token == 1 ? bytes("<BOS>") : token == 2 ? bytes("<EOS>") : bytes("<SEP>");
                for (uint256 j; j < control.length; ++j) result[written++] = control[j];
            } else if (token < 260) {
                result[written++] = bytes1(uint8(token - 4));
            } else if (token < 260 + DOMAIN_COUNT) {
                uint256 offset = _u16(offsets, (token - 260) * 2);
                uint256 end = _u16(offsets, (token - 259) * 2);
                for (uint256 j = offset; j < end; ++j) result[written++] = dictionary[j];
            } else {
                bytes memory marker = _reserved(token);
                for (uint256 j; j < marker.length; ++j) result[written++] = marker[j];
            }
        }
        assembly ("memory-safe") { mstore(result, written) }
    }
}
