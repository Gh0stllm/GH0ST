pragma solidity 0.8.30;

interface IS0ULGreetingController {
    // All fields are static. The deployed mapping getter's flattened return
    // values have the same ABI encoding as this static tuple.
    struct Binding {
        address owner;
        uint16 allowedActions;
        uint64 stateRevision;
        bool adopted;
        uint8 outcome;
        uint8 action;
        uint8 reason;
        bytes32 promptHash;
        bytes32 outputHash;
        bytes32 expectedActionHash;
    }
    function requests(uint256 id) external view returns (Binding memory);
    function resultOf(uint256 id) external view returns (bytes memory output, bytes memory result);
    function engine() external view returns (address);
    function model() external view returns (address);
    function tokenizer() external view returns (address);
    function engineCodeHash() external view returns (bytes32);
    function modelCodeHash() external view returns (bytes32);
    function tokenizerCodeHash() external view returns (bytes32);
    function modelId() external view returns (bytes32);
    function sourceCheckpoint() external view returns (bytes32);
}

interface IS0ULGreetingEngine {
    struct Status {
        address owner;
        uint8 phase;
        uint16 position;
        uint16 layer;
        uint16 row;
        uint16 head;
        uint16 promptLength;
        uint16 maxNewTokens;
        uint16 generated;
        uint256 saturationCount;
        bool done;
        bool cancelled;
        bool logitsReady;
    }
    function status(uint256 id) external view returns (Status memory);
    function outputTokens(uint256 id) external view returns (uint16[] memory);
    function model() external view returns (address);
    function tokenizer() external view returns (address);
    function modelId() external view returns (bytes32);
}

interface IS0ULGreetingModel {
    function modelId() external view returns (bytes32);
    function sourceCheckpoint() external view returns (bytes32);
}

/// @notice A requester-authorized, deterministic greeting tool for an existing agent.
/// @dev The fixed message is tool output, not text generated by the trained model.
/// A successfully executed, exactly constrained model action supplies provenance.
/// This extension does not modify the controller, engine, model, memory or tasks.
contract S0ULAgentGreeting {
    string public constant MESSAGE = "Hello World";

    IS0ULGreetingController public immutable controller;
    IS0ULGreetingEngine public immutable engine;
    address public immutable model;
    address public immutable tokenizer;
    bytes32 public immutable controllerCodeHash;
    bytes32 public immutable engineCodeHash;
    bytes32 public immutable modelCodeHash;
    bytes32 public immutable tokenizerCodeHash;
    bytes32 public immutable modelId;
    bytes32 public immutable sourceCheckpoint;
    mapping(uint256 => bool) public used;

    error InvalidConfiguration();
    error SourceChanged();
    error InvalidSource();
    error NotOwner();
    error AlreadySpoken();

    event Greeting(uint256 indexed requestId, address indexed owner, address indexed controller,
        bytes32 modelId, bytes32 sourceOutputHash, bytes32 sourceActionHash, string message);

    constructor(address controller_, bytes32 expectedControllerCodeHash, bytes32 expectedModelId) {
        if (controller_.code.length == 0 || expectedControllerCodeHash == 0 || expectedModelId == 0
            || controller_.codehash != expectedControllerCodeHash) revert InvalidConfiguration();
        IS0ULGreetingController candidate = IS0ULGreetingController(controller_);
        address engine_ = candidate.engine();
        address model_ = candidate.model();
        address tokenizer_ = candidate.tokenizer();
        bytes32 checkpoint = candidate.sourceCheckpoint();
        if (engine_.code.length == 0 || model_.code.length == 0 || tokenizer_.code.length == 0
            || engine_.codehash != candidate.engineCodeHash()
            || model_.codehash != candidate.modelCodeHash()
            || tokenizer_.codehash != candidate.tokenizerCodeHash()
            || candidate.modelId() != expectedModelId || checkpoint == 0
            || IS0ULGreetingEngine(engine_).model() != model_
            || IS0ULGreetingEngine(engine_).tokenizer() != tokenizer_
            || IS0ULGreetingEngine(engine_).modelId() != expectedModelId
            || IS0ULGreetingModel(model_).modelId() != expectedModelId
            || IS0ULGreetingModel(model_).sourceCheckpoint() != checkpoint)
            revert InvalidConfiguration();
        controller = candidate;
        engine = IS0ULGreetingEngine(engine_);
        model = model_;
        tokenizer = tokenizer_;
        controllerCodeHash = expectedControllerCodeHash;
        engineCodeHash = engine_.codehash;
        modelCodeHash = model_.codehash;
        tokenizerCodeHash = tokenizer_.codehash;
        modelId = expectedModelId;
        sourceCheckpoint = checkpoint;
    }

    /// @notice The original requester explicitly invokes this fixed greeting once.
    function sayHello(uint256 id) external returns (string memory) {
        if (used[id]) revert AlreadySpoken();
        _checkPins();
        IS0ULGreetingController.Binding memory b = controller.requests(id);
        if (b.owner != msg.sender) revert NotOwner();
        if (b.outcome != 2 || b.reason != 0 || b.expectedActionHash == 0)
            revert InvalidSource();
        IS0ULGreetingEngine.Status memory s = engine.status(id);
        if (!s.done || s.cancelled || s.phase != 17
            || s.owner != (b.adopted ? b.owner : address(controller))) revert InvalidSource();
        uint16[] memory ids = engine.outputTokens(id);
        if (ids.length < 2 || ids.length > 32 || s.generated != ids.length
            || ids[ids.length - 1] != 2 || keccak256(abi.encode(ids)) != b.outputHash)
            revert InvalidSource();
        (bytes memory output,) = controller.resultOf(id);
        bytes32 actionHash = keccak256(output);
        if (actionHash != b.expectedActionHash) revert InvalidSource();
        // All external calls above are static; no external call follows consumption.
        used[id] = true;
        emit Greeting(id, b.owner, address(controller), modelId, b.outputHash, actionHash, MESSAGE);
        return MESSAGE;
    }

    function messageOf(uint256 id) external view returns (string memory) {
        return used[id] ? MESSAGE : "";
    }

    function _checkPins() private view {
        if (address(controller).codehash != controllerCodeHash
            || address(engine).codehash != engineCodeHash || model.codehash != modelCodeHash
            || tokenizer.codehash != tokenizerCodeHash || controller.engine() != address(engine)
            || controller.model() != model || controller.tokenizer() != tokenizer
            || controller.modelId() != modelId || controller.sourceCheckpoint() != sourceCheckpoint
            || engine.model() != model || engine.tokenizer() != tokenizer || engine.modelId() != modelId
            || IS0ULGreetingModel(model).modelId() != modelId
            || IS0ULGreetingModel(model).sourceCheckpoint() != sourceCheckpoint)
            revert SourceChanged();
    }
}
