// CPU-only Runpod fixtures: no wallet, key, signatures, real RPC or broadcasts.
import assert from 'node:assert/strict';
import * as fs from 'node:fs';
import {join} from 'node:path';
import {createHash} from 'node:crypto';
import {Transaction,Interface} from 'ethers';
import * as P from './policy.mjs';
import {Journal} from './journal.mjs';
import {SetupEngine} from './engine.mjs';
assert.equal(process.platform,'linux');
const root=process.env.GL3_TEST_ROOT;assert(root?.startsWith('/workspace/gl3/child-setup-tests/'));fs.mkdirSync(root,{recursive:true,mode:0o700});
const policy=JSON.parse(fs.readFileSync(new URL('./fee-policy.fixture.json',import.meta.url)));
const H='1'.repeat(64),B='0x'+'2'.repeat(64),TX='0x'+'3'.repeat(64),A=n=>'0x'+n.toString(16).padStart(40,'0');
const plan={schema:'gh0st.gl3.child-setup.review.v1',owner:P.OWNER,parentChainId:4663,childChainId:4663001,genesisHash:P.GENESIS,depositUnits:String(P.FUNDING),feeMode:'fresh-market',aggregateFeeCeilings:null,parentNonceBase:50,factoryAddress:A(1),inboxAddress:A(2),bridgeAddress:A(3),rollupAddress:A(4),outboxAddress:A(5),creationTransactionHash:TX,creationReceiptBlockHash:B,parentConfirmationBlocks:1,feePolicySHA256:H,priorUserConsentSHA256:H,receiptPacketSHA256:H,deploymentAuditSHA256:H,automaticTopups:false,extraHeartbeatTransactions:false};plan.actions=P.actionTemplates(plan);
let count=0;const results=[];async function test(name,f){await f();count++;results.push({name,passed:true});}
await test('exact2parent+7child templates,1,000,000-token approval/deposit and ordered nonce0..6',()=>{P.validatePlan(plan);P.validatePolicy(policy);assert.equal(plan.actions.length,9);assert.equal(P.FUNDING,1000000000000000000000000n);assert.equal(plan.feeMode,'fresh-market');assert.equal(plan.aggregateFeeCeilings,null);assert.equal(P.token.decodeFunctionData('approve',plan.actions[0].data)[1],P.FUNDING);assert.equal(P.inbox.decodeFunctionData('depositERC20',plan.actions[1].data)[0],P.FUNDING);assert.deepEqual(plan.actions.slice(2).map(x=>x.nonce),[0,1,2,3,4,5,6]);});
await test('reject missingbindings,old100or1m+100deposit,oldaggregatecaps,wronggenesis/order/hiddenmint/nonce',()=>{for(const patch of [{inboxAddress:null},{maxParentFeeWei:'100000000000000'},{maxChildFeeUnits:'100000000000000000000'},{feeMode:'capped'},{aggregateFeeCeilings:{ETH:'1'}},{depositUnits:'100000000000000000000'},{depositUnits:String(P.FUNDING+100000000000000000000n)},{priorUserConsentSHA256:null},{receiptPacketSHA256:null},{deploymentAuditSHA256:null},{genesisHash:B},{parentNonceBase:0.5}])assert.throws(()=>P.validatePlan({...plan,...patch}));const q=structuredClone(plan);[q.actions[2],q.actions[3]]=[q.actions[3],q.actions[2]];assert.throws(()=>P.validatePlan(q));const r=structuredClone(plan);r.actions[8].data=P.admin.encodeFunctionData('addChainOwner',[P.OWNER]);assert.throws(()=>P.validatePlan(r));});
await test('source-backed full L1 floor retains45.813B component despite ordinary500795 estimate',()=>{const f=P.fullGasFloor(500795n,21252n,45813000000n);assert.equal(f.gasLimit,54975635502n);assert(f.gasLimit>16777216n);assert.throws(()=>P.fullGasFloor(1n,16777216n,1n));});
const state={owners:[P.OWNER],minters:[],managementFrom:'0',upgrade:['0','0'],minimum:String(P.TARGET),network:P.OWNER,infra:P.OWNER,reward:P.OWNER,baseFee:String(P.TARGET),quote:String(P.TARGET),number:'0xa'};
await test('authority guards reject minters,upgrade,wrongowner/treasury; exact final[0]',()=>{P.validateAuthority(state,0);for(const patch of [{minters:[P.OWNER]},{upgrade:[]},{upgrade:['1','0']},{owners:[P.ZERO]}])assert.throws(()=>P.validateAuthority({...state,...patch},0));assert.throws(()=>P.validateAuthority({...state,network:A(9)},3));P.validateAuthority({...state,owners:[P.ZERO]},7);assert.throws(()=>P.validateAuthority({...state,owners:[P.ZERO,P.OWNER]},7));});
await test('genuine settle requires laterblock,matching header+directquote+minimum;bothsetterbarriers',()=>{assert(P.settled(state,{blockNumber:'0x9'}));for(const patch of [{number:'0x9'},{baseFee:'100000000'},{quote:'100000000'},{minimum:'100000000'}])assert(!P.settled({...state,...patch},{blockNumber:'0x9'}));});
const now=Date.now(),obs={normal:'500795',compute:'21252',l1:'45813000000',gasLimit:String(P.fullGasFloor(500795,21252,45813000000).gasLimit),price:'100000000'};
const q={...obs,index:2,planSHA256:H,feeMode:'fresh-market',createdAt:now,expiresAt:now+30000,...P.makeUnsigned(plan.actions[2],obs)};
await test('unsignedJIT type2quote bindsplan/chain/to/calldata/nonce/fullfloor/freshcap;nostalequote',()=>{const t=P.validateQuotedAction(plan,q,H,now);assert.equal(t.maxPriorityFeePerGas,0n);assert.equal(t.maxFeePerGas,200000000n);for(const patch of [{planSHA256:'4'.repeat(64)},{index:3},{gasLimit:'500795'},{maxCostUnits:'0'},{estimatedFeeUnits:'0'},{expiresAt:now-1}])assert.throws(()=>P.validateQuotedAction(plan,{...q,...patch},H,now));assert.throws(()=>P.makeUnsigned({...plan.actions[2],skipL1Charging:true},obs));assert.throws(()=>P.validateSignedEnvelope(t,q));});
let sends=0;const fake={send:async()=>{sends++;throw Error('No actual RPC permitted');}};
let j;const dir=join(root,'journal');fs.mkdirSync(dir,{mode:0o700});
await test('durable0700/0600 journal,exclusive lock,no overwrite of existingplan and intent-before-network',()=>{j=new Journal(dir,H);assert.equal(fs.statSync(j.path).mode&0o777,0o600);assert.throws(()=>new Journal(dir,H));j.setQuote(q);j.intent({index:0,chainId:4663,hash:TX,raw:'TEST-NOT-A-SIGNATURE',maxCostUnits:'1'});assert.equal(JSON.parse(fs.readFileSync(j.path)).entries[0].state,'intent');j.close();assert.throws(()=>new Journal(dir,'5'.repeat(64)));j=new Journal(dir,H);assert.equal(j.value.entries.length,1);});
await test('ambiguousintent blocks nextquote and never auto retries',async()=>{const e=new SetupEngine({plan,planSHA256:H,policy,journal:j,parent:fake,child:fake});await assert.rejects(()=>e.quote(),/reconciliation/);assert.equal(sends,0);j.update(0,{state:'uncertain'});assert.throws(()=>j.intent({index:1}));});
j.close();
await test('journal rejects symlink parent and permissive directory',()=>{const loose=join(root,'loose');fs.mkdirSync(loose,{mode:0o755});fs.chmodSync(loose,0o755);assert.throws(()=>new Journal(loose,H));const link=join(root,'link');fs.symlinkSync(dir,link);assert.throws(()=>new Journal(link,H));});
const jd=join(root,'unsigned');fs.mkdirSync(jd,{mode:0o700});const jj=new Journal(jd,H);jj.setQuote(q);const e=new SetupEngine({plan,planSHA256:H,policy,journal:jj,parent:fake,child:fake,now:()=>now});
await test('unsignedpayload cannot reach RPCsend and privatejournal stores no key/password',async()=>{await assert.rejects(()=>e.submit(q.unsignedSerialized));assert.equal(sends,0);const txt=fs.readFileSync(jj.path,'utf8');assert(!/privateKey|password|mnemonic/.test(txt));});jj.close();
await test('real quote construction uses full estimate plus isolated compute and direct L1component/freshprice',async()=>{const requests=[];const rpc={send:async(m,p)=>{requests.push({m,p});if(m==='eth_estimateGas')return p[0].skipL1Charging?'0x5304':'0x7a44b';if(m==='eth_call')return P.ni.encodeFunctionResult('gasEstimateL1Component',[45813000000n,100000000n,100000000n]);if(m==='eth_gasPrice')return '0x5f5e100';throw Error(m);}};const en=new SetupEngine({plan,planSHA256:H,policy,journal:{value:{entries:[]}},parent:rpc,child:rpc});const o=await en.observation(plan.actions[2]);assert.equal(o.gasLimit,obs.gasLimit);assert.equal(requests[0].p[0].skipL1Charging,undefined);assert.equal(requests[1].p[0].skipL1Charging,true);assert.equal(requests.at(-1).m,'eth_gasPrice');});
await test('chain/genesis guards fail before creation receipt or send',async()=>{for(const bad of ['chain','genesis']){let sendCount=0;const parent={send:async m=>{if(m==='eth_chainId')return bad==='chain'?'0x1':P.qty(4663);throw Error(m);}},child={send:async(m)=>{if(m==='eth_chainId')return P.qty(4663001);if(m==='eth_getBlockByNumber')return {hash:B};sendCount++;throw Error(m);}};const en=new SetupEngine({plan,planSHA256:H,policy,journal:{value:{entries:[]}},parent,child});await assert.rejects(()=>en.bindings());assert.equal(sendCount,0);}});
await test('canonical history rejects reorged/failed/unconfirmed receipts without resend',async()=>{const r={status:'0x1',transactionHash:TX,blockHash:B,blockNumber:'0x9'};let active=r;const rpc={send:async(m)=>m==='eth_getTransactionReceipt'?active:m==='eth_getBlockByNumber'?{hash:B}:'0xa'};const en=new SetupEngine({plan,planSHA256:H,policy,journal:{value:{entries:[{state:'confirmed',chainId:4663,hash:TX,receipt:r}]}},parent:rpc,child:rpc});await en.verifyHistory();for(const bad of [{...r,blockHash:TX},{...r,status:'0x0'},null]){active=bad;await assert.rejects(()=>en.verifyHistory());}});
await test('freshnonce guard rejects pending or advanced nonce',async()=>{const rpc={send:async(m,p)=>p[1]==='pending'?'0x1':'0x0'};const en=new SetupEngine({plan,planSHA256:H,policy,journal:{value:{entries:[]}},parent:rpc,child:rpc});await assert.rejects(()=>en.nonce(rpc,0),/nonce/);});
await test('both genuine settle barriers block nextsignature before observedmatchinglaterheader',async()=>{for(const index of [3,4]){const a=plan.actions[index],j={value:{entries:Array.from({length:index},(_,i)=>({state:'confirmed',receipt:{blockNumber:'0xa'}}))}};const rpc={send:async m=>m==='eth_getTransactionCount'?P.qty(a.nonce):'0x0'};const en=new SetupEngine({plan,planSHA256:H,policy,journal:j,parent:rpc,child:rpc});en.bindings=async()=>{};en.verifyHistory=async()=>{};en.authority=async()=>state;await assert.rejects(()=>en.preflight(a),/Wait for a genuine/);en.authority=async()=>({...state,number:'0xb'});await en.preflight(a);}});
await test('actualNitroreceipt must exposeL1component and boundednonnegativecompute beforeconfirmation',()=>{assert.deepEqual(P.receiptGas({gasUsed:'100000021252',gasUsedForL1:'100000000000'},true),{totalGasUsed:'100000021252',l1PosterGasUsed:'100000000000',l2ComputeGasUsed:'21252'});for(const r of [{gasUsed:'21252'},{gasUsed:'21252',gasUsedForL1:'21253'},{gasUsed:'16777217',gasUsedForL1:'0'}])assert.throws(()=>P.receiptGas(r,true));assert.deepEqual(P.receiptGas({gasUsed:'21000'},false),{totalGasUsed:'21000'});});
await test('actualpassed27receiptpacket bindsreview;failedfinalaudit orwrongevent/genesis cannotstart',()=>{const bytes=fs.readFileSync(new URL('./receipt-packet.fixture.json',import.meta.url)),auditBytes=fs.readFileSync(new URL('./deployment-verified.fixture.json',import.meta.url)),packet=JSON.parse(bytes),audit=JSON.parse(auditBytes),sha=b=>createHash('sha256').update(b).digest('hex'),event=audit.RollupCreated;const p={...plan,factoryAddress:audit.receipts[26].to,rollupAddress:event.rollupAddress,inboxAddress:event.inboxAddress,bridgeAddress:event.bridge,outboxAddress:event.outbox,creationTransactionHash:audit.creationTransactionHash,creationReceiptBlockHash:audit.creationBlockHash,receiptPacketSHA256:sha(bytes),deploymentAuditSHA256:sha(auditBytes)};assert(P.validateReceiptEvidence(p,packet,audit,sha(bytes),sha(auditBytes)));for(const mutate of [d=>d.check.passed=false,d=>d.receipts[0].status=0,d=>d.RollupCreated.inboxAddress=A(99),d=>d.genesisStateReceipt.blockHash=B]){const d=structuredClone(audit);mutate(d);assert.throws(()=>P.validateReceiptEvidence(p,packet,d,sha(bytes),sha(auditBytes)));}assert.throws(()=>P.validateReceiptEvidence(p,{...packet,passed:false},audit,sha(bytes),sha(auditBytes)));});
await test('EIP1559livefee drift fits signedheadroom;overcap/overgas/zero/expiredquotes stayblocked',()=>{const t=P.validateQuotedAction(plan,q,H,now);assert(P.validateFreshFees(t,{price:String(t.maxFeePerGas),gasLimit:String(t.gasLimit)}));assert(P.validateFreshFees(t,{price:String(BigInt(q.price)+1n),gasLimit:String(t.gasLimit-1n)}));for(const o of [{price:String(t.maxFeePerGas+1n),gasLimit:String(t.gasLimit)},{price:'0',gasLimit:String(t.gasLimit)},{price:q.price,gasLimit:String(t.gasLimit+1n)},{price:q.price,gasLimit:'0'},{price:q.price,gasLimit:String(t.gasLimit),skipL1Charging:true}])assert.throws(()=>P.validateFreshFees(t,o));assert.throws(()=>P.validateQuotedAction(plan,q,H,now+30000));assert.throws(()=>P.validateQuotedAction(plan,q,H,now+30001));assert.equal(t.unsignedHash,q.unsignedHash);assert.equal(t.maxFeePerGas,2n*BigInt(q.price));assert.equal(t.maxPriorityFeePerGas,0n);});
await test('freshmarket removes aggregateceilings but preserves signedmaxfees/estimates and exactprincipal',()=>{const parentObs={normal:'100000',gasLimit:'130000',price:'10000000000'},pq={...parentObs,index:0,feeMode:'fresh-market',planSHA256:H,createdAt:now,expiresAt:now+30000,...P.makeUnsigned(plan.actions[0],parentObs)};const pt=P.validateQuotedAction(plan,pq,H,now);assert(BigInt(pq.maxCostUnits)>100000000000000n);assert(BigInt(pq.estimatedFeeUnits)===100000n*10000000000n);const childObs={...obs,price:'100000000000'},cq={...childObs,index:2,feeMode:'fresh-market',planSHA256:H,createdAt:now,expiresAt:now+30000,...P.makeUnsigned(plan.actions[2],childObs)};P.validateQuotedAction(plan,cq,H,now);assert(BigInt(cq.maxCostUnits)>100000000000000000000n);assert.equal(pt.value,0n);assert.equal(P.token.decodeFunctionData('approve',pt.data)[1],P.FUNDING);assert(!Object.hasOwn(plan,'maxParentFeeWei')&&!Object.hasOwn(plan,'maxChildFeeUnits'));});
const result={schema:'gh0st.gl3.child-setup.validation.v1',passed:count,results,scope:'Runpod CPU-only mocked RPC/unsigned policy/filesystem tests; no signature or actual chain execution',keysRead:false,transactionsSigned:0,transactionsBroadcast:0,actualRPCRequests:0};fs.writeFileSync(join(root,'test-result.json'),JSON.stringify(result,null,2)+'\n');fs.writeFileSync(new URL('./test-result.json',import.meta.url),JSON.stringify(result,null,2)+'\n');fs.writeFileSync(new URL('./test-plan.fixture.json',import.meta.url),JSON.stringify(plan,null,2)+'\n');console.log(JSON.stringify(result));
