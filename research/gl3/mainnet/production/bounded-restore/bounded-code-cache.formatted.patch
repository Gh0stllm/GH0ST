+// CodeUncached reads clean historical code through the identical reader without
+// retaining its bytes in this account object. Cached/dirty code remains authoritative.
+func (s *stateObject) CodeUncached() []byte {
+	if s.dirtyCode || len(s.code) != 0 {
+		return s.Code()
+	}
+	if bytes.Equal(s.CodeHash(), types.EmptyCodeHash.Bytes()) {
+		return nil
+	}
+	var code []byte
+	defer func(start time.Time) {
+		s.db.CodeLoaded += 1
+		s.db.CodeReads += time.Since(start)
+		s.db.CodeLoadBytes += len(code)
+	}(time.Now())
+	code = s.db.reader.Code(s.address, common.BytesToHash(s.CodeHash()))
+	if len(code) == 0 {
+		s.db.setError(fmt.Errorf("code is not found %x", s.CodeHash()))
+	} else {
+		s.codeReadUncached = true
+	}
 	return code
 }
 
