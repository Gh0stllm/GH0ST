+// GetCodeUncached is an optional read-only extension for sealed historical data.
+// It preserves account access, reader authentication, witness and error handling.
+func (s *StateDB) GetCodeUncached(addr common.Address) []byte {
+	stateObject := s.getStateObject(addr)
+	if stateObject == nil {
+		return nil
+	}
+	code := stateObject.CodeUncached()
+	if s.witness != nil {
+		s.witness.AddCode(code)
+	}
+	return code
