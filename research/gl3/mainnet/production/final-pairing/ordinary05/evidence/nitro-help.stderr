      --node.block-metadata-fetcher.max-sync-interval duration                                                 maximum time between blockMetadata requests (default 32m0s)
      --node.block-metadata-fetcher.source.arg-log-limit uint                                                  limit size of arguments in log entries (default 2048)
      --node.block-metadata-fetcher.source.connection-wait duration                                            how long to wait for initial connection
