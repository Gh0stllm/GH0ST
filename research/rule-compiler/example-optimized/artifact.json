  "solidity": "// SPDX-License-Identifier: MIT\npragma solidity 0.8.30;\n\ncontract Quote {\n    function quote(uint8 qty, uint8 tier) external pure returns (uint32) {\n        return uint32((uint256(qty) * ((uint256(tier) == uint256(1)) ? uint256(95) : ((uint256(tier) == uint256(2)) ? uint256(90) : uint256(100)))));\n    }\n}\n",
  "javascript": "export function quote(qty, tier) {\n  if (![qty, tier].every(x => Number.isInteger(x) && x >= 0 && x <= 255)) throw RangeError(\"Expected uint8 inputs\");\n  return (qty * ((tier === 1) ? 95 : ((tier === 2) ? 90 : 100)));\n}\n",
