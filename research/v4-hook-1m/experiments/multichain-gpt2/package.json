{
  "name": "gh0st-multichain-gpt2-research",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "plan": "node scripts/plan.mjs",
    "benchmark": "node scripts/local-benchmark.mjs",
    "prepare:deployment": "node scripts/prepare-deployment.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "worker": "node scripts/worker.mjs",
    "model:fetch": "python3 model/fetch.py",
    "model:export": "python3 model/export.py",
    "model:reference": "python3 model/reference.py --quick --tokens=2",
    "plan:optimized": "node scripts/plan.mjs --config=config/chains.optimized.json --out=reports/optimized-partition.json",
    "benchmark:optimized": "node scripts/optimized-benchmark.mjs --layout=config/optimized-layout.json --engine=GPT2ShardOptimized",
    "benchmark:baseline-native": "node scripts/optimized-benchmark.mjs --layout=config/baseline-native-layout.json --engine=GPT2Shard --out=reports/baseline-native-full",
    "costs": "node scripts/estimate-costs.mjs",
    "plan:job": "node scripts/job-plan.mjs",
    "prepare:job": "node scripts/prepare-job-deployment.mjs",
    "verify:job": "node scripts/verify-job-deployment.mjs",
    "worker:job": "node scripts/job-worker.mjs",
    "relay:job": "node scripts/job-relay.mjs",
    "costs:economy": "node scripts/estimate-economy-costs.mjs",
    "test:costs:economy": "node tests/economy-costs.mjs",
    "benchmark:job": "node scripts/job-benchmark.mjs",
    "benchmark:job:opbnb": "node scripts/job-benchmark.mjs --compute=opbnb --out=reports/job-opbnb-full",
    "posting:opbnb": "node scripts/quote-opbnb-posting.mjs"
  },
  "dependencies": {
    "ethers": "6.13.5"
  },
  "devDependencies": {
    "solc": "0.8.30",
    "@layerzerolabs/oapp-evm": "0.4.1",
    "@layerzerolabs/lz-evm-protocol-v2": "3.0.168",
    "@layerzerolabs/lz-evm-messagelib-v2": "3.0.168",
    "@layerzerolabs/lz-evm-v1-0.7": "3.0.168",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "solidity-bytes-utils": "0.8.4"
  }
}
