  "math": {
    "integer_division": "truncate toward zero for all signed divisions; positive floor for table interpolation and RMS mean",
    "linear": "output[r]=trunc(sum(weightQ12[r,c]*inputQ12[c])/4096); check every output fits signed int32",
    "rms": "mean=floor(sum(x*x)/128); denominator=isqrt(mean+17); normalized=trunc(x*4096/denominator); output=trunc(normalized*gammaQ12/4096)",
    "rope": "Llama split-half rotation in each32-component head; pairs(j,j+16); first=trunc((x[j]*cosQ12-x[j+16]*sinQ12)/4096); second=trunc((x[j+16]*cosQ12+x[j]*sinQ12)/4096); inv_freq=10000^(-2*j/32), j0..15",
    "attention_score": "trunc(sum(qQ12[j]*kQ12[j])/23170), over32components; causal keys0..query_position; KVhead=floor(Qhead/2)",
    "softmax": "d=maxScore-score; idx=floor(d*16/4096), rem=d*16-idx*4096; idx>=256=>expWeight0; else expWeight=floor((expTable[idx]*(4096-rem)+expTable[idx+1]*rem)/4096); output=trunc(sum(expWeight*vQ12)/sum(expWeight))",
    "silu": "a=abs(xQ12); idx=floor(a*16/4096),rem=a*16-idx*4096; idx>=256=>positiveProbability65536; else positiveProbability=floor((sigmoidQ16[idx]*(4096-rem)+sigmoidQ16[idx+1]*rem)/4096); probability=positiveProbability for x>=0 else65536-positiveProbability; output=trunc(xQ12*probability/65536)",
    "mlp": "gate=silu(linear_gate(norm)); up=linear_up(norm); product=trunc(gate*up/4096); down=linear_down(product); residual add",
    "residual": "exact signed addition; reject signed-int32 overflow",
    "next_token": "argmax all4019 final logits, lowest index breaks ties"
  },
