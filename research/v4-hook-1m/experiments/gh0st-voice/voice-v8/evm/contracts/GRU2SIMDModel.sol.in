// SPDX-License-Identifier: MIT
pragma solidity 0.8.30;
contract GRU2SIMDModel {
 uint16 public constant VOCABULARY=8192;uint256 public constant HIDDEN=@STATE@;uint256 public constant WIDTH=@H@;
 uint256 public constant SOURCE_MODEL_PARAMETERS=@PARAMS@;
 uint256 constant CHUNK=24000;uint256 constant PAGE=1024;
 uint256 public constant CORE_BYTES=@CORE@;uint256 public constant GROUP_BYTES=@GROUP@;uint256 public constant WORD_BYTES=@WORD@;
 uint256 public constant VOCABULARY_BYTES=262144;uint256 public constant FUSED_BYTES=@FUSED@;uint256 public constant PUNCTUATION_BYTES=@PUNCT@;
 uint256 constant CORE_STRIDE=@CSTRIDE@;uint256 constant HEAD_STRIDE=@HSTRIDE@;uint256 constant CORE_MATRICES=@CMAT@;uint256 constant PUNCT_FOLD=@PFOLD@;
 address public immutable coreCatalog;address public immutable groupCatalog;address public immutable wordCatalog;
 address public immutable vocabularyCatalog;address public immutable fusedCatalog;address public immutable punctuationCatalog;bytes32 public immutable modelHash;
 error InvalidModel();error InvalidInput();
 bytes private constant SIGMOID_DELTA=hex"";bytes private constant EXP_Q32=hex"";
 constructor(address c,address g,address w,address v,address f,address p){if(block.chainid!=31337)revert InvalidModel();
  bytes32 a=_pin(c,CORE_BYTES);bytes32 d=_pin(g,GROUP_BYTES);bytes32 e=_pin(w,WORD_BYTES);bytes32 j=_pin(v,VOCABULARY_BYTES);bytes32 k=_pin(f,FUSED_BYTES);bytes32 l=_pin(p,PUNCTUATION_BYTES);
  coreCatalog=c;groupCatalog=g;wordCatalog=w;vocabularyCatalog=v;fusedCatalog=f;punctuationCatalog=p;
  modelHash=keccak256(abi.encode("GH0ST_GRU2_SIMD8_H@H@_Q10_LOCAL_V1",a,d,e,j,k,l));}
 function _entry(address a,uint256 i)private view returns(address v){assembly("memory-safe"){extcodecopy(a,0,add(1,mul(i,20)),20)v:=shr(96,mload(0))}}
 function _source(address a,uint256 i)private view returns(address){return _entry(_entry(a,i/PAGE),i%PAGE);}
 function _pin(address a,uint256 total)private view returns(bytes32 h){uint256 n=(total+CHUNK-1)/CHUNK;uint256 pages=(n+PAGE-1)/PAGE;
  if(a.code.length!=1+pages*20)revert InvalidModel();for(uint256 p;p<pages;++p){uint256 m=n-p*PAGE;if(m>PAGE)m=PAGE;if(_entry(a,p).code.length!=1+m*20)revert InvalidModel();}
  for(uint256 i;i<n;++i){address t=_source(a,i);uint256 len=total-i*CHUNK;if(len>CHUNK)len=CHUNK;if(t.code.length!=len+1)revert InvalidModel();h=keccak256(abi.encode(h,t.codehash));}}
 function _readInto(address a,uint256 off,uint256 len,bytes memory data)private view {uint256 copied;while(copied<len){uint256 at=off+copied;uint256 within=at%CHUNK;uint256 take=CHUNK-within;if(take>len-copied)take=len-copied;address src=_source(a,at/CHUNK);assembly("memory-safe"){extcodecopy(src,add(add(data,32),copied),add(within,1),take)}copied+=take;}}
 function _read(address a,uint256 off,uint256 len)private view returns(bytes memory d){d=new bytes(len);_readInto(a,off,len,d);}
 function _weight(bytes memory d,uint256 i)private pure returns(int256 x){assembly("memory-safe"){x:=signextend(1,shr(240,mload(add(add(d,32),mul(i,2)))))}}
 function _input(bytes memory d,uint256 i)private pure returns(int256 x){assembly("memory-safe"){x:=signextend(4,shr(216,mload(add(add(d,32),mul(i,5)))))}}
 function _prepare(int16[@STATE@] memory v,uint256 offset)private pure returns(bytes memory packedVector,int256 shiftedSum){packedVector=new bytes(WIDTH*4);
  assembly("memory-safe"){for{let i:=0}lt(i,@H@){i:=add(i,8)}{let packedValue:=0 for{let j:=0}lt(j,8){j:=add(j,1)}{let value:=add(signextend(1,mload(add(v,shl(5,add(offset,add(i,j)))))),1024)shiftedSum:=add(shiftedSum,value)packedValue:=or(packedValue,shl(mul(j,32),value))}mstore(add(add(packedVector,32),mul(i,4)),packedValue)}}}
 function _dot(address catalog,uint256 row,uint256 stride,bytes memory buffer,bytes memory vector,int256 shiftedSum)private view returns(int256 sum){_readInto(catalog,row*stride,stride,buffer);
  assembly("memory-safe"){let weights:=add(buffer,32)let values:=add(vector,32)let end:=@H4@
   for{let at:=0}lt(at,end){at:=add(at,128)}{
    sum:=add(sum,shr(224,mul(mload(add(values,at)),mload(add(weights,at)))))
    sum:=add(sum,shr(224,mul(mload(add(values,add(at,32))),mload(add(weights,add(at,32))))))
    sum:=add(sum,shr(224,mul(mload(add(values,add(at,64))),mload(add(weights,add(at,64))))))
    sum:=add(sum,shr(224,mul(mload(add(values,add(at,96))),mload(add(weights,add(at,96))))))}
   sum:=sub(sub(sum,mul(32768,shiftedSum)),mul(1024,mload(add(weights,end))))}}
 function _headBias(bytes memory d)private pure returns(int256 v){assembly("memory-safe"){v:=mload(add(add(d,32),@H4PLUS32@))}}
 function _dot6(bytes memory d,uint256 offset,int32[6] memory vector)private pure returns(int256 sum){assembly("memory-safe"){let ptr:=add(add(d,32),mul(offset,2))for{let i:=0}lt(i,6){i:=add(i,1)}{let w:=signextend(1,shr(240,mload(add(ptr,mul(i,2)))))sum:=add(sum,mul(w,signextend(3,mload(add(vector,mul(i,32))))))}}}
 function _sigmoid(int256 x,bytes memory d)private pure returns(int256){uint256 a=uint256(x<0?-x:x);uint256 i=(a+32)/64;if(i>256)i=256;uint32 delta=(uint32(uint8(d[2*i]))<<8)|uint32(uint8(d[2*i+1]));return int256(uint256(((x>=0?32768+delta:32768-delta)+32)/64));}
 function _cell(int256 xr,int256 rr,int256 xz,int256 rz,int256 xn,int256 rn,int16 old,bytes memory t)private pure returns(int16){int256 r=_sigmoid(xr+rr,t);int256 z=_sigmoid(xz+rz,t);int256 n=2*_sigmoid(2*(xn+r*rn/1024),t)-1024;return int16((z*int256(old)+(1024-z)*n)/1024);}
 function _sample(int256[197] memory scores,uint256 start,uint256 count,uint256 temperature,uint256 entropy)private pure returns(uint256){int256 maximum=scores[start];for(uint256 i=1;i<count;++i)if(scores[start+i]>maximum)maximum=scores[start+i];bytes memory t=EXP_Q32;uint256[] memory weights=new uint256[](count);uint256 total;
  for(uint256 i;i<count;++i){uint256 at=(uint256(maximum-scores[start+i])*1024/temperature+32)/64;if(at>256)at=256;uint256 w;assembly("memory-safe"){w:=shr(192,mload(add(add(t,32),mul(at,8))))}weights[i]=w;total+=w;}
  uint256 draw=entropy%total;for(uint256 i;i<count;++i){if(draw<weights[i])return i;draw-=weights[i];}revert InvalidInput();}
 function word(uint16 token)public view returns(bytes32 value,uint8 length){if(token>=8192)revert InvalidInput();bytes memory d=_read(vocabularyCatalog,uint256(token)*32,32);assembly("memory-safe"){value:=mload(add(d,32))}for(uint256 i;i<32&&value[i]!=0;++i){uint8 c=uint8(value[i]);if(!((c>=97&&c<=122)||(c==39&&i>0)))revert InvalidModel();length++;}if(length==0)revert InvalidModel();}
 function stepSampled(uint16 previous,uint8 previousPunct,int16[@STATE@] memory state,int32[6] memory features,bytes32 seed,uint256 wordIndex,uint16 temperature)external view returns(uint16 token,uint8 punct,int16[@STATE@] memory next,int256[197] memory scores,string memory text,bool terminal){
  if(previous>8192||previousPunct>4||temperature<64||temperature>4096)revert InvalidInput();for(uint256 i;i<@STATE@;++i)if(state[i]<-1024||state[i]>1024)revert InvalidInput();for(uint256 i;i<6;++i)if(features[i]<-4096||features[i]>4096)revert InvalidInput();
  bytes memory row=_read(fusedCatalog,uint256(previous)*@FROW@,@FROW@);bytes memory pr=_read(punctuationCatalog,PUNCT_FOLD+uint256(previousPunct)*@FROW@,@FROW@);bytes memory aux=_read(coreCatalog,CORE_MATRICES,@AUX@);bytes memory table=SIGMOID_DELTA;bytes memory buffer=new bytes(HEAD_STRIDE);
  (bytes memory old1,int256 sum1)=_prepare(state,0);(bytes memory old2,int256 sum2)=_prepare(state,@H@);
  for(uint256 i;i<@H@;++i){int256 xr=(_input(row,i)+_input(pr,i)+_dot6(aux,i*6,features))/1024;int256 xz=(_input(row,@H@+i)+_input(pr,@H@+i)+_dot6(aux,(@H@+i)*6,features))/1024;int256 xn=(_input(row,@H2@+i)+_input(pr,@H2@+i)+_dot6(aux,(@H2@+i)*6,features))/1024;
   next[i]=_cell(xr,_dot(coreCatalog,i,CORE_STRIDE,buffer,old1,sum1)/1024,xz,_dot(coreCatalog,@H@+i,CORE_STRIDE,buffer,old1,sum1)/1024,xn,_dot(coreCatalog,@H2@+i,CORE_STRIDE,buffer,old1,sum1)/1024,state[i],table);}
  (bytes memory new1,int256 newSum1)=_prepare(next,0);
  for(uint256 i;i<@H@;++i){int256 xr=(_dot(coreCatalog,@H3@+i,CORE_STRIDE,buffer,new1,newSum1)+_weight(aux,@H18@+i)*1024)/1024;int256 xz=(_dot(coreCatalog,@H4M@+i,CORE_STRIDE,buffer,new1,newSum1)+_weight(aux,@H19@+i)*1024)/1024;int256 xn=(_dot(coreCatalog,@H5@+i,CORE_STRIDE,buffer,new1,newSum1)+_weight(aux,@H20@+i)*1024)/1024;
   next[@H@+i]=_cell(xr,_dot(coreCatalog,@H6@+i,CORE_STRIDE,buffer,old2,sum2)/1024,xz,_dot(coreCatalog,@H7@+i,CORE_STRIDE,buffer,old2,sum2)/1024,xn,_dot(coreCatalog,@H8@+i,CORE_STRIDE,buffer,old2,sum2)/1024,state[@H@+i],table);}
  (bytes memory out,int256 outSum)=_prepare(next,@H@);
  for(uint256 i;i<128;++i){int256 value=_dot(groupCatalog,i,HEAD_STRIDE,buffer,out,outSum);scores[i]=(value+_headBias(buffer)*1024)/1024;}
  uint256 group=_sample(scores,0,128,temperature,uint256(keccak256(abi.encode(seed,wordIndex,uint256(0)))));
  for(uint256 i;i<64;++i){int256 value=_dot(wordCatalog,group*64+i,HEAD_STRIDE,buffer,out,outSum);scores[128+i]=(value+_headBias(buffer)*1024)/1024;}
  token=uint16(group*64+_sample(scores,128,64,temperature,uint256(keccak256(abi.encode(seed,wordIndex,uint256(1))))));bytes memory pb=_read(punctuationCatalog,@PHBYTES@+uint256(token)*10,10);
  for(uint256 i;i<5;++i){int256 value=_dot(punctuationCatalog,i,HEAD_STRIDE,buffer,out,outSum);scores[192+i]=(value+(_headBias(buffer)+_weight(pb,i))*1024)/1024;}
  punct=uint8(_sample(scores,192,5,temperature,uint256(keccak256(abi.encode(seed,wordIndex,uint256(2))))));(bytes32 v,uint8 size)=word(token);bytes memory output=new bytes(uint256(size)+(punct==0?0:1));for(uint256 i;i<size;++i)output[i]=v[i];if(punct!=0)output[size]=punct==1?bytes1(","):punct==2?bytes1("."):punct==3?bytes1("!"):bytes1("?");return(token,punct,next,scores,string(output),punct>=2);
 }
}
