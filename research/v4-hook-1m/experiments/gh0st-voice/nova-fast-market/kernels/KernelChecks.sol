pragma solidity 0.8.30;
contract Kernels {
error InvalidInput();
bytes private constant EXP_Q32=hex"";
bytes private constant OLD=hex"";
bytes private constant FAST=hex"";
function oldSigmoid(int256 x,bytes memory d) private pure returns(int256 result){
assembly("memory-safe") {
let a:=x if slt(x,0){a:=sub(0,x)}
let index:=shr(6,add(a,32)) if gt(index,256){index:=256}
let delta:=shr(240,mload(add(add(d,32),shl(1,index))))
let value:=add(32768,delta) if slt(x,0){value:=sub(32768,delta)}
result:=shr(6,add(value,32))
}}
function newSigmoid(int256 x,bytes memory d) private pure returns(int256 result){
assembly("memory-safe") {
let a:=x let neg:=0 if slt(x,0){a:=sub(0,x) neg:=514}
let index:=shr(6,add(a,32)) if gt(index,256){index:=256}
result:=shr(240,mload(add(add(d,32),add(neg,mul(index,2)))))
}}
function checkSigmoid(int256 start,uint256 count) external pure returns(bool){bytes memory a=OLD;bytes memory b=FAST;for(uint256 i;i<count;i++){int256 x=start+int256(i);require(oldSigmoid(x,a)==newSigmoid(x,b),"sigmoid mismatch");}return true;}
 function _sampleOld(int256[197] memory scores,uint256 start,uint256 count,uint256 temperature,uint256 entropy)private pure returns(uint256){int256 maximum=scores[start];for(uint256 i=1;i<count;++i)if(scores[start+i]>maximum)maximum=scores[start+i];bytes memory t=EXP_Q32;uint256[] memory weights=new uint256[](count);uint256 total;
  for(uint256 i;i<count;++i){uint256 at=(uint256(maximum-scores[start+i])*1024/temperature+32)/64;if(at>256)at=256;uint256 w;assembly("memory-safe"){w:=shr(192,mload(add(add(t,32),mul(at,8))))}weights[i]=w;total+=w;}
  uint256 draw=entropy%total;for(uint256 i;i<count;++i){if(draw<weights[i])return i;draw-=weights[i];}revert InvalidInput();}

 function _sampleNew(int256[197] memory scores,uint256 start,uint256 count,uint256 temperature,uint256 entropy) private pure returns(uint256 result) {
  bytes memory t=EXP_Q32;
  uint256[] memory weights=new uint256[](count);
  assembly("memory-safe") {
   let source:=add(scores,mul(start,32))
   let maximum:=mload(source)
   for {let i:=1}lt(i,count){i:=add(i,1)} {
    let value:=mload(add(source,mul(i,32)))
    if sgt(value,maximum) {maximum:=value}
   }
   let total:=0
   let dest:=add(weights,32)
   for {let i:=0}lt(i,count){i:=add(i,1)} {
    let index:=div(add(div(mul(sub(maximum,mload(add(source,mul(i,32)))),1024),temperature),32),64)
    if gt(index,256){index:=256}
    let weight:=shr(192,mload(add(add(t,32),mul(index,8))))
    mstore(add(dest,mul(i,32)),weight)
    total:=add(total,weight)
   }
   let draw:=mod(entropy,total)
   result:=count
   for {let i:=0}lt(i,count){i:=add(i,1)} {
    let weight:=mload(add(dest,mul(i,32)))
    if lt(draw,weight){result:=i break}
    draw:=sub(draw,weight)
   }
  }
  if(result==count) revert InvalidInput();
 }

function checkSample(int256[197] memory scores,uint256 start,uint256 count,uint256 temperature,uint256 entropy) external pure returns(uint256 result){result=_sampleOld(scores,start,count,temperature,entropy);require(result==_sampleNew(scores,start,count,temperature,entropy),"sample mismatch");}
}