type Evidence = record {
  finding : text;
  simulated_address : text;
  ordinary_mint : text;
  ordinary_before : text;
  ordinary_after : text;
  control_before : text;
  control_after : text;
};
type Check = variant { Ok : Evidence; Err : text };
type Rule = variant { Mint : record {balance_of : bool}; Authorization; Withdraw : record {takes_amount : bool}; Replay; TokenReturn : record {credit_slot : opt nat64}; Underflow };
type RuleResult = record {reproduced : bool; observed : vec record {text; text}};
type Profile = record {bytes:nat32; hash:text; selectors:vec text; delegatecall:nat32; origin:nat32; selfdestruct:nat32; external_call:nat32};
type Headers=vec record{text;text};
type HttpRequest=record{method:text;url:text;headers:Headers;body:blob;certificate_version:opt nat16};
type HttpResponse=record{status_code:nat16;headers:Headers;body:blob;upgrade:opt bool};
type SpawnConfig = record {name:text;personality:text;addresses:vec text;tools:vec text;daily_cap:nat32};
type SpawnActivity = record {id:nat64;at:nat64;address:text;status:text;source_block:opt nat64;source_at:opt nat64;lines:vec text;fee:nat32};
type SpawnProject = record {owner:principal;config:SpawnConfig;created_at:nat64;updated_at:nat64;activity:vec SpawnActivity};
type SpawnHttp = record {status:nat;headers:vec record {name:text;value:text};body:blob};
service : {
  spawn_save : (SpawnConfig) -> (variant {Ok:SpawnProject;Err:text});
  spawn_get : (principal) -> (opt SpawnProject) query;
  spawn_run : (text) -> (variant {Ok:SpawnActivity;Err:text});
  spawn_transform : (record {context:blob;response:SpawnHttp}) -> (SpawnHttp) query;
  explain_scan : (vec nat8) -> (variant {Ok:text; Err:text});
  summary_state : (vec nat8) -> (record {note:opt text;can_generate:bool}) query;
  cached_summary : (vec nat8) -> (opt text) query;
  http_request : (HttpRequest) -> (HttpResponse) query;
  inspect_runtime : (blob) -> (variant{Ok:Profile;Err:text}) query;
  interpret : (Rule, text, principal) -> (variant {Ok : record {evidence : RuleResult; model_answer : opt text; status : text}; Err : text});
  check_contract : (Rule, text) -> (variant {Ok : RuleResult; Err : text}) query;
  check_mint : (text, bool) -> (Check) query;
  demo : () -> (record { open_mint : Check; protected_mint : Check }) query;
}
