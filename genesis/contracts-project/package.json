{
  "name": "gh0st-genesis-mint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fixed-supply GH0ST Genesis ERC-721 with atomic native burn-to-mint.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "npm run compile && node --test --test-concurrency=1 test/*.test.mjs",
    "prepare:config": "node scripts/prepare-config.mjs",
    "preflight": "node scripts/prepare-config.mjs",
    "test:fork": "node scripts/test-mainnet-fork.mjs",
    "prepare:deployment": "node scripts/prepare-deployment.mjs",
    "verify:shards": "node scripts/verify-all-shards.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "6.15.0",
    "ganache": "7.9.2",
    "solc": "0.8.30"
  }
}
