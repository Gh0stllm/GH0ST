type Config = record {
  confirmations : nat64;
  artifact_hash : text;
  ecdsa_key_name : text;
  rpc_urls : vec text;
  swap_sources : opt vec SwapPool;
  chain_id : nat64;
  gateway : text;
  model_canister : principal;
  model_cycle_budget : nat;
  model_wasm_hash : text;
  worker : principal;
  model_id : text;
};
type DeferredSwap = record {
  id : text;
  model_cycles : nat;
  deferred_at : nat64;
  reason : text;
};
type HttpHeader = record { value : text; name : text };
type HttpResponse = record {
  status : nat;
  body : blob;
  headers : vec HttpHeader;
};
type Job = record {
  signature : blob;
  output_tokens : nat64;
  source : opt SwapSource;
  voice : opt VoiceJob;
  busy : bool;
  request : Request;
  model_cycles : nat;
  answer : text;
  error : text;
  recovery : opt RecoveryInfo;
  signer : text;
  digest : text;
  phase : Phase;
  chunks : nat32;
  input_tokens : nat64;
  prompt_ingested : bool;
  model_cycles_before : nat;
};
type JobPage = record { total : nat64; jobs : vec Job; next : opt text };
type Phase = variant { Failed; Complete; Running; ReadyToSign; Verified };
type RecoveryInfo = record {
  last_error : text;
  retry_after : nat64;
  grants : nat32;
  segment_baseline : opt nat;
  total_budget : nat;
  rebuilding : bool;
  accounting_uncertain : bool;
  chunks_at_recovery : nat32;
  requires_owner : bool;
  replay_target : text;
  replay_target_tokens : nat64;
  replay_tokens : nat64;
  cache_evidence_hash : opt text;
  replay_prompt_ingested : bool;
  safe_retry_count : nat32;
  carry_cycles : nat;
  max_chunks : nat32;
  parked : bool;
  resume_deadline : nat64;
  replay_output : text;
};
type Request = record {
  id : text;
  requester : text;
  block_hash : text;
  log_index : nat64;
  prompt_hash : text;
  deadline : nat64;
  block_number : nat64;
  max_tokens : nat32;
  prompt : text;
  tx_hash : text;
  model_id : text;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : Job; Err : text };
type Result_2 = variant { Ok : VoiceState; Err : text };
type Result_3 = variant { Ok : text; Err : text };
type RetentionStatus = record {
  admission_allowed : bool;
  active : opt text;
  busy : nat64;
  open : nat64;
  completed : nat64;
  verifying : bool;
  retained : nat64;
  blocked_failed : bool;
  failed : nat64;
  paused : bool;
};
type SwapPool = record {
  fee : nat32;
  manager : text;
  currency0 : text;
  currency1 : text;
  hook : text;
  pool_id : text;
  tick_spacing : int32;
};
type SwapSource = record {
  manager : text;
  transaction_hash : text;
  log_index : nat64;
  pool_id : text;
};
type ThoughtMemory = record {
  request_id : text;
  direction : text;
  manager : opt text;
  "text" : text;
  source_block : nat64;
  callback_log_index : nat64;
  callback_tx_hash : text;
  pool_id : text;
};
type TransformArgs = record { context : blob; response : HttpResponse };
type VoiceJob = record {
  direction : text;
  previous_input_tokens : nat64;
  attempt : nat8;
  memory_hash : text;
  profile_version : text;
  seed : nat32;
  generation : opt nat;
  quality_error : text;
  previous_output_tokens : nat64;
  base_prompt : text;
  remembered : bool;
  profile_hash : text;
};
type VoiceState = record {
  memories : vec ThoughtMemory;
  recent_outputs : vec text;
  revision : nat64;
  remembering : opt text;
};
service : (Config) -> {
  // Stop a job without repeating or replacing any inference output. An in-flight
  // model call must finish first so its callback cannot overwrite this decision.
  abort : (text) -> (Result);
  advance : (text) -> (Result_1);
  // The canister must exist to derive its key before the EVM gateway is deployed.
  // Bind that gateway once; later changes require a separately reviewed upgrade.
  bind_gateway : (text) -> (Result);
  // Remove stable-memory prompt caches only after completion. Held failed caches
  // remain available for explicit recovery. Does not delete
  // request tombstones or signatures; replay protection survives upgrades.
  cleanup : (text) -> (Result);
  defer_failed_swap : (text, nat, text) -> (Result);
  enable_unlimited_swaps : (nat) -> (Result);
  get_config : () -> (Config) query;
  get_deferred_swaps : () -> (vec DeferredSwap) query;
  get_job : (text) -> (opt Job) query;
  get_voice_state : () -> (VoiceState) query;
  list_jobs : () -> (vec Job) query;
  // Prefer this bounded history reader to the legacy full-history list_jobs.
  list_jobs_page : (opt text, nat32) -> (JobPage) query;
  // Owner-reviewed artifact migration only. Never grants model budget or changes
  // the worker, model, chain, source IDs, prompts or existing result signatures.
  rebind_gateway : (text, text, text, text) -> (Result);
  // Explicit bounded owner recovery; workers cannot grant themselves more work.
  recover_job : (text, nat) -> (Result_1);
  // A retained thought becomes character memory only after independently
  // verifying its exact, confirmed RH fulfillment. Repeated acknowledgements are
  // free of repeated RPC work and cannot append duplicate memories.
  remember_delivered : (text, text, nat64) -> (Result_2);
  resume_job : (text) -> (Result_1);
  resume_retained_job : (text, nat, nat32, text) -> (Result_1);
  // Bounded operational status; completed/failed history consumes no work slot.
  retention_status : () -> (RetentionStatus) query;
  set_paused : (bool) -> (Result);
  signer_address : () -> (Result_3);
  submit_request : (text, nat64) -> (Result_1);
  // A confirmed existing-pool Swap log can start inference without modifying the
  // pool or creating a separate RH request transaction. The caller supplies only
  // the transaction hash and log index; source facts and prompt are derived here.
  submit_swap : (text, nat64) -> (Result_1);
  // Canonical JSON and no volatile HTTP headers, so IC nodes agree on replies.
  transform : (TransformArgs) -> (HttpResponse) query;
}