RH_CHAIN_ID=4663
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_GATEWAY=
ICP_HOST=https://icp-api.io
ICP_COORDINATOR=
# Exported Ed25519KeyIdentity JSON, stored outside the repository.
ICP_IDENTITY_FILE=
# Start at the gateway deployment block, never an inferred latest block.
START_BLOCK=
JOURNAL=.state/worker.json
POLL_MS=15000
# Optional. Without this the worker saves the signed callback for any relayer.
RH_RELAYER_PRIVATE_KEY=
RELAY_MAX_FEE_GWEI=
RELAY_GAS_LIMIT_CAP=500000
